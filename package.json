{
  "name": "package-conflicts-resolver",
  "version": "1.1.3",
  "description": "A Node.js CLI tool that automatically resolves conflicts in package.json and package-lock.json files",
  "main": "dist/index.js",
  "bin": {
    "resolve-conflicts": "dist/cli.js",
    "package-conflicts-resolver": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"dist/test/**/*.test.js\"",
    "test:watch": "node --test --watch \"dist/test/**/*.test.js\"",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist",
    "uninstall": "node dist/cli.js uninstall",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "check": "npm run format:check && npm run lint && npm run build && npm test",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:next": "node scripts/release.mjs next"
  },
  "keywords": [
    "package.json",
    "package-lock.json",
    "git",
    "merge",
    "conflicts",
    "cli",
    "resolver",
    "npm"
  ],
  "author": "Daniel Amenou (https://github.com/DanielAmenou)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielAmenou/package-conflicts-resolver.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/DanielAmenou"
  },
  "homepage": "https://github.com/DanielAmenou/package-conflicts-resolver/blob/main/README.md",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
